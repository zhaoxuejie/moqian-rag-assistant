# ============================================================
# 环境变量样例 —— 复制为 .env 后填写（.env 已被 .gitignore 忽略）
# 变量名与 pydantic-settings 字段一一对应；LLM_* 兼容旧的 BASE_URL/MODEL/API_KEY
# ============================================================

# ---- LLM（OpenAI 兼容三件套）----
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=sk-请填写
# 推理模型的推理 token 也计入 max_tokens，生成类调用预算给足（实测 16 会导致 content 为空）
LLM_MAX_TOKENS=1200
# 带证据回答的预算（最多 8 个步骤 + 每步引用；太小会把最后一步截断）
LLM_ANSWER_MAX_TOKENS=2600
LLM_TIMEOUT_SECONDS=60

# ---- 数据库（docker-compose 内 app 用 host=db；本机直连用 127.0.0.1:5433）----
DATABASE_URL=postgresql://moqian:moqian@127.0.0.1:5433/moqian
POSTGRES_USER=moqian
POSTGRES_PASSWORD=moqian
POSTGRES_DB=moqian

# ---- 检索（Dense + BM25 → RRF）----
RETRIEVAL_TOP_K_DENSE=20
RETRIEVAL_TOP_K_BM25=20
RETRIEVAL_RERANK_CANDIDATES=30
RETRIEVAL_FINAL_TOP_N=12
RETRIEVAL_RRF_K=60
RETRIEVAL_MIN_SCORE=0.35
# 按型号/批次过滤后命中少于该数量 → 回退全库检索（纪律 2 的延伸）
RETRIEVAL_MIN_FILTERED_HITS=3

# ---- 证据门（Evidence Gate，机制在 modules、规则由 app 注入）----
# 纪律 4：证据不足必须拒答；三条硬指标任一不满足都走 gap
EVIDENCE_MIN_HITS=1
EVIDENCE_MIN_COVERAGE=0.5

# ---- 重排（默认关闭；接入重排服务时再打开）----
# none = 只用 RRF；tencent = 腾讯云 AI Search；llama_cpp = 本地 llama-server（预留）
RERANKER_PROVIDER=none
RERANKER_MODEL=bge-reranker-v2-m3
# RERANKER_BASE_URL=https://bj.aisearch.tencentelasticsearch.com/v1
# RERANKER_API_KEY=腾讯云 AI Search 的 API Key（也可用 RERANk_KEY）
# RERANKER_TIMEOUT_SECONDS=10

# ---- 身份（阈值 80%，不自动开通工号）----
IDENTITY_RECOGNIZABLE_THRESHOLD=0.8
IDENTITY_AUTO_PROVISION=false

# ---- 治理域认证（JWT HS256）----
# 部署到公网前必须改！留默认值只用于本机开发
JWT_SECRET=dev-only-change-me-please-32bytes!
JWT_TTL_MINUTES=480

# ---- 初始管理员（首次启动 app.seed_admin 建档；口令只从环境变量读，不进仓库）----
ADMIN_INITIAL_ACCOUNT=admin
ADMIN_INITIAL_NAME=系统管理员
# 留空则跳过建档（服务照常启动）
ADMIN_INITIAL_PASSWORD=

# ---- /chat 模式（默认 pipeline）----
# pipeline：检索 + 证据门 + 引用校验，正式问答
# skeleton：直连模型验证链路，输出带「骨架模式」标识、不带引用（只用于自检）
CHAT_MODE=pipeline

# ---- 转人工（热线与时段可在后台修改）----
HANDOFF_HOTLINE=400-000-0000
HANDOFF_HOURS=工作日 8:30–18:00

# ---- 安全规则词表（逗号分隔；留空用 app/domain.py 默认词表）----
# SAFETY_WORDS=带电检修,短接安全回路,盘车

# ---- 任务 worker ----
TASK_POLL_SECONDS=2
TASK_HEARTBEAT_SECONDS=15
TASK_STALE_SECONDS=120
TASK_MAX_ATTEMPTS=3

# ---- embedding（本机 Ollama 的 OpenAI 兼容端点，bge-m3 返回 1024 维）----
# 本机直跑：http://localhost:11434/v1
# 容器内跑：docker-compose 已覆盖为 http://host.docker.internal:11434/v1（可用 EMBEDDING_BASE_URL_DOCKER 改）
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024
# EMBEDDING_API_KEY=        # Ollama 默认不需要
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=120

# ---- 文档入库 ----
# 原件目录，相对仓库根；容器内挂载为 /app/data，所以保持 data 即可
DATA_DIR=data
DOC_INGEST_CHUNK_MAX_CHARS=700
DOC_INGEST_CHUNK_MIN_CHARS=120
# 扫描件（抽不出文字）直接判失败并提示需 OCR
DOC_INGEST_REJECT_SCANNED=true

# ---- 登录验证码 / 知识自测入口（可被后台 config 覆盖）----
# 默认关闭验证码；开启后登录页拉取一次性 SVG 挑战（5 分钟）
CAPTCHA_ENABLED=false
# 后台右下角知识自测入口默认开启
PREVIEW_ENABLED=true

# ---- 公开演示模式（默认关闭；关闭时浮层直接可用，无需入口码）----
# DEMO_ENABLED=false
# DEMO_REQUIRE_CODE=true
# DEMO_PUBLIC_CODE=web
# 预约链接：留空则前端不显示「预约」按钮
# DEMO_BOOKING_URL=
# ---- 运行 ----
APP_ENV=dev
LOG_LEVEL=INFO

# ---- 镜像构建（可选）----
# 容器内直连 pypi 很慢时改镜像源；留空则用 docker-compose.yml 里的默认值（清华源）
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
